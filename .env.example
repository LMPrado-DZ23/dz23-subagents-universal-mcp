# DZ23 Subagents Universal MCP 3.0.0 - example configuration.
# The installers copy this file to .env only when .env is absent. Never commit .env.
# Empty values keep the built-in defaults described in docs/OPERATIONS.md.
# Values are read literally: do not add comments after a value on the same line.
# Invalid values (for example DZ23_ALLOW_PAID=yes) stop the server with exit code 78.

# --- State and transport ---
DZ23_STATE_DIR=~/.dz23-subagents
DZ23_ALLOW_HTTP=false
DZ23_HTTP_HOST=127.0.0.1
DZ23_HTTP_PORT=8787
DZ23_ALLOWED_HOSTS=
DZ23_ALLOWED_ORIGINS=

# --- HTTP authentication: set only one of DZ23_MCP_TOKEN or DZ23_MCP_TOKEN_FILE ---
# With HTTP enabled the token needs at least 32 random characters, otherwise the server does not start.
DZ23_MCP_TOKEN=
DZ23_MCP_TOKEN_FILE=
# single-user (default) or scoped. Scoped mode reads SHA-256 digests and scopes from DZ23_MCP_TOKENS_FILE.
DZ23_AUTH_MODE=single-user
DZ23_MCP_TOKENS_FILE=
# Docker healthcheck only: with scoped tokens and no primary token, point this at any scoped token file.
DZ23_HEALTHCHECK_TOKEN_FILE=

# --- HTTP rate limiting and request limits (per process, not distributed) ---
DZ23_RATE_LIMIT_ENABLED=true
DZ23_RATE_LIMIT_WINDOW_MS=60000
DZ23_RATE_LIMIT_POINTS=120
DZ23_RATE_LIMIT_TOOL_POINTS=60
DZ23_RATE_LIMIT_CONCURRENT=4
DZ23_RATE_LIMIT_WEIGHTS=
DZ23_HTTP_MAX_BODY_BYTES=1048576
DZ23_HTTP_BODY_TIMEOUT_MS=10000
DZ23_HTTP_HEADERS_TIMEOUT_MS=10000
DZ23_HTTP_MAX_INFLIGHT=32
DZ23_HTTP_MAX_CONNECTIONS=128
DZ23_HTTP_SOCKET_TIMEOUT_MS=900000
DZ23_SHUTDOWN_GRACE_MS=10000

# --- MCP behaviour and input limits ---
# auto: JSON-RPC -32602 for 2025-06-18 clients, tool execution error for 2025-11-25 clients.
DZ23_TOOL_ARGUMENT_ERRORS=auto
DZ23_MAX_PROMPT_CHARS=32000
DZ23_MAX_GOAL_CHARS=8000
DZ23_MAX_STDIO_FRAME_BYTES=524288

# --- Logging: JSON Lines on stderr (error, warn, info, debug) ---
DZ23_LOG_LEVEL=info

# --- Routing, concurrency and retries ---
# Without DZ23_ROTATION, explicit targets may only use a provider's default model unless DZ23_ALLOW_PAID=true.
DZ23_ROUTING_POLICY=free-first
DZ23_ROTATION=custom:qwen3-coder
DZ23_ALLOW_PAID=false
DZ23_MAX_CONCURRENCY=7
DZ23_MAX_WORKERS_PER_TARGET=4
DZ23_MAX_QUEUE=32
DZ23_PROVIDER_TIMEOUT_MS=90000
DZ23_HEALTH_TIMEOUT_MS=15000
DZ23_MAX_RETRIES=1
DZ23_RETRY_BASE_DELAY_MS=500
DZ23_RETRY_AFTER_CAP_MS=30000
DZ23_MAX_OUTPUT_TOKENS=4096
DZ23_MAX_RESPONSE_BYTES=2097152

# --- Budget: empty means no limit. Prices come only from an explicit table. ---
# Empty policy: deny_unknown_cost when any cost limit is set, otherwise allow_unknown_cost.
DZ23_COST_POLICY=
DZ23_MAX_CALL_COST_USD=
DZ23_MAX_MISSION_COST_USD=
DZ23_MAX_PROJECT_COST_USD=
DZ23_MAX_DAILY_COST_USD=
DZ23_MAX_MISSION_TOKENS=
DZ23_MAX_MISSION_CALLS=
DZ23_MAX_INPUT_TOKENS=
DZ23_PRICES_FILE=
DZ23_PRICES=

# --- Memory ---
DZ23_MAX_CONTEXT_CHARS=60000
DZ23_MAX_STORED_OUTPUT_CHARS=12000
DZ23_MAX_AGENT_OUTPUTS=16
DZ23_MAX_JOURNAL_BYTES=1048576
DZ23_MAX_CHECKPOINTS=8
DZ23_MAX_CHECKPOINT_LIST_ITEMS=500
DZ23_MAX_STATE_BYTES=4194304
DZ23_LOCK_TIMEOUT_MS=20000
DZ23_LOCK_STALE_MS=30000
DZ23_MEMORY_FSYNC=true

# --- Local OpenAI-compatible server used by the example rotation ---
# Local providers (custom, lmstudio, vllm) are enabled only when a base URL, model or key is set, or when
# DZ23_ROTATION names them. The default-model rule exempts them only on loopback or private addresses.
CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
CUSTOM_MODEL=qwen3-coder
CUSTOM_API_KEY=local

# --- Cloud providers: fill privately, or use <NAME>_FILE for a mounted secret file ---
# <PROVIDER>_MODEL overrides the suggested model; <PROVIDER>_BASE_URL overrides the endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
GITHUB_TOKEN=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NOVITA_API_KEY=
NOVITA_MODEL=
UPSTAGE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_MODEL=
HYPERBOLIC_API_KEY=
HYPERBOLIC_MODEL=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=
LMSTUDIO_API_KEY=
VLLM_API_KEY=
