# DZ23 Subagents 2.2.4. Copy to a PRIVATE .env only if absent.
# The public repository must never contain the filled .env.
DZ23_STATE_DIR=~/.dz23-subagents
DZ23_HTTP_HOST=127.0.0.1
DZ23_HTTP_PORT=8787
# Required (32+ characters) for non-loopback binding. Use TLS outside localhost.
DZ23_MCP_TOKEN=
# Comma-separated public hostnames/origins to allow through a trusted reverse proxy.
DZ23_ALLOWED_HOSTS=
DZ23_ALLOWED_ORIGINS=
# free-first ranks categories; ordered preserves the configured order.
DZ23_ROUTING_POLICY=free-first
DZ23_MAX_CONCURRENCY=6
DZ23_MAX_WORKERS_PER_TARGET=4
DZ23_PROVIDER_TIMEOUT_MS=90000
DZ23_HEALTH_TIMEOUT_MS=15000
DZ23_MAX_CONTEXT_CHARS=120000
# Blocks paid/low-cost categories, not account-dependent bills on mixed/free tiers.
DZ23_ALLOW_PAID=false
# SAFE START: local endpoint only. Choose a model actually installed on your server.
DZ23_ROTATION=custom:qwen3-coder
CUSTOM_BASE_URL=http://127.0.0.1:11434/v1
CUSTOM_API_KEY=local
CUSTOM_MODEL=qwen3-coder
# Set only providers you use. Any key can be provided via NAME_FILE instead.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
GITHUB_TOKEN=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NOVITA_API_KEY=
NOVITA_MODEL=
UPSTAGE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_MODEL=
HYPERBOLIC_API_KEY=
HYPERBOLIC_MODEL=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=
LMSTUDIO_API_KEY=
VLLM_API_KEY=
# Examples: GROQ_API_KEY_FILE=/run/secrets/groq
# Model IDs are account/provider dependent. Configure MODEL or provider:model explicitly.
# ElevenLabs/Deepgram are NOT adapters in this release; speech is on the roadmap.
