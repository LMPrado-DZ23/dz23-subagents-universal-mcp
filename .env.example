# DZ23 Subagents Universal MCP 4.1.0 — modelo de configuração
# Copie para .env na pasta da instalação e preencha só as chaves que você tem.
# Chave vazia = provedor desligado. Nunca coloque valores reais neste arquivo de exemplo.
# Variáveis do ambiente do harness (ex.: env do ~/.claude.json) têm precedência sobre o .env.
# Qualquer chave também pode vir de arquivo: <NOME>_FILE=C:\caminho\para\arquivo

# ---------------------------------------------------------------------------
# Custo e roteamento
# ---------------------------------------------------------------------------
# free-first (local e free-tier primeiro) ou rotation-order (ordem exata de DZ23_ROTATION)
DZ23_ROUTING_POLICY=free-first
# false = nunca usar alvos pagos, low-cost ou mixed sem liberação explícita
DZ23_ALLOW_PAID=false
# Lista provider:model separada por vírgula. Vazio = modelo padrão de cada provedor habilitado.
DZ23_ROTATION=
# Modelos de provedores "mixed" que são realmente grátis na SUA conta (provider:model exato)
DZ23_FREE_MODELS=
# Hostnames tratados como rede privada além de IPs privados/localhost (ex.: ollama,gateway.lan)
DZ23_PRIVATE_HOSTS=
# true = GITHUB_TOKEN, HF_TOKEN, CLOUDFLARE_API_TOKEN/AUTH_TOKEN habilitam provedores sem estarem na rotação
DZ23_ALLOW_GENERIC_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Chaves dos provedores cadastrados (tier entre parênteses)
# ---------------------------------------------------------------------------
# Pagos (bloqueados sem DZ23_ALLOW_PAID=true)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# Low-cost (bloqueado sem DZ23_ALLOW_PAID=true)
DEEPSEEK_API_KEY=

# Mixed: só com DZ23_FREE_MODELS, ou modelo :free no OpenRouter, ou DZ23_ALLOW_PAID=true
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
NOVITA_API_KEY=
UPSTAGE_API_KEY=
OLLAMA_API_KEY=
HYPERBOLIC_API_KEY=
ALIBABA_API_KEY=

# Free-tier (podem cobrar acima da cota grátis da sua conta)
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_TOKEN=
GITHUB_MODELS_TOKEN=
CLOUDFLARE_WORKERS_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Locais (loopback, IP privado ou host em DZ23_PRIVATE_HOSTS; modelos :cloud contam como mixed)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
LMSTUDIO_API_KEY=
LMSTUDIO_BASE_URL=
LMSTUDIO_MODEL=
VLLM_API_KEY=
VLLM_BASE_URL=
VLLM_MODEL=

# Sobrescritas opcionais de endpoint/modelo de provedores de nuvem: só com prefixo DZ23_
# (OPENAI_BASE_URL, GROQ_MODEL etc. sem prefixo são ignorados). Exemplos:
# DZ23_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DZ23_GROQ_MODEL=llama-3.3-70b-versatile
# DZ23_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<conta>/ai/v1

# ---------------------------------------------------------------------------
# Orçamento (vazio = sem limite)
# ---------------------------------------------------------------------------
DZ23_MAX_DAILY_COST_USD=
DZ23_MAX_MISSION_COST_USD=
DZ23_MAX_PROJECT_COST_USD=
DZ23_MAX_CALL_COST_USD=
DZ23_MAX_MISSION_TOKENS=
DZ23_MAX_MISSION_CALLS=
DZ23_MAX_INPUT_TOKENS=
# allow_unknown_cost ou deny_unknown_cost (padrão deny quando há limite de custo)
DZ23_COST_POLICY=
# Preços por provider:model em JSON inline ou arquivo (ver config/examples/prices.example.json)
DZ23_PRICES=
DZ23_PRICES_FILE=

# ---------------------------------------------------------------------------
# Memória e estado (valores mostrados são os padrões)
# ---------------------------------------------------------------------------
# Leitura de projeto (workspace_read, workspace_search, git_readonly, context): vazio desliga.
# Só estas pastas (caminho real) podem ser lidas; arquivos de credencial são bloqueados e segredos mascarados.
# DZ23_WORKSPACE_ROOTS=/caminho/absoluto/projeto,/outro/workspace
# DZ23_WORKSPACE_MAX_FILE_BYTES=262144
# DZ23_WORKSPACE_MAX_ENTRIES=500
# DZ23_WORKSPACE_MAX_FILES=2000
# DZ23_WORKSPACE_MAX_LINE_CHARS=4000
# DZ23_WORKSPACE_MAX_OUTPUT_CHARS=262144
# DZ23_WORKSPACE_COMMAND_TIMEOUT_MS=10000
# DZ23_STATE_DIR=~/.dz23-subagents
# DZ23_MEMORY_FSYNC=true
# DZ23_MAX_CONTEXT_CHARS=60000
# DZ23_MAX_STORED_OUTPUT_CHARS=12000
# DZ23_MAX_AGENT_OUTPUTS=16
# DZ23_MAX_JOURNAL_BYTES=1048576
# DZ23_MAX_CHECKPOINTS=8
# DZ23_MAX_STATE_BYTES=4194304
# DZ23_MAX_CHECKPOINT_LIST_ITEMS=500
# DZ23_LOCK_TIMEOUT_MS=20000
# DZ23_LOCK_STALE_MS=30000

# ---------------------------------------------------------------------------
# Execução, retries e limites (padrões)
# ---------------------------------------------------------------------------
# DZ23_MAX_CONCURRENCY=7
# DZ23_MAX_WORKERS_PER_TARGET=4
# DZ23_MAX_QUEUE=32
# DZ23_PROVIDER_TIMEOUT_MS=90000
# DZ23_HEALTH_TIMEOUT_MS=15000
# DZ23_DELEGATE_DEADLINE_MS=600000
# DZ23_MAX_OUTPUT_TOKENS=4096
# DZ23_MAX_RESPONSE_BYTES=2097152
# DZ23_MAX_PROMPT_CHARS=32000
# DZ23_MAX_GOAL_CHARS=8000
# DZ23_RESPONSE_CACHE_TTL_MS=0
# DZ23_MAX_MISSION_JOBS=2
# DZ23_MISSION_DEADLINE_MS=3600000
# DZ23_MAX_RETRIES=1
# DZ23_RETRY_BASE_DELAY_MS=500
# DZ23_RETRY_AFTER_CAP_MS=30000
# DZ23_SHARED_COOLDOWNS=true
# DZ23_STDIO_MAX_INFLIGHT=8
# DZ23_MAX_STDIO_FRAME_BYTES=524288
# DZ23_TOOL_ARGUMENT_ERRORS=auto
# DZ23_LOG_LEVEL=info
# DZ23_SHUTDOWN_GRACE_MS=10000

# ---------------------------------------------------------------------------
# HTTP (desligado por padrão; stdio não precisa de nada disto)
# ---------------------------------------------------------------------------
DZ23_ALLOW_HTTP=false
DZ23_MCP_TOKEN=
DZ23_MCP_TOKEN_FILE=
# single-user ou scoped (scoped exige DZ23_MCP_TOKENS_FILE com digests SHA-256)
# DZ23_AUTH_MODE=single-user
DZ23_MCP_TOKENS_FILE=
# DZ23_ALLOW_UNAUTHENTICATED_LOCAL_HTTP=false
# DZ23_HTTP_HOST=127.0.0.1
# DZ23_HTTP_PORT=8787
# DZ23_ALLOWED_HOSTS=
# DZ23_ALLOWED_ORIGINS=
# DZ23_HTTP_MAX_BODY_BYTES=1048576
# DZ23_HTTP_BODY_TIMEOUT_MS=10000
# DZ23_HTTP_HEADERS_TIMEOUT_MS=10000
# DZ23_HTTP_MAX_INFLIGHT=32
# DZ23_HTTP_MAX_CONNECTIONS=128
# DZ23_HTTP_SOCKET_TIMEOUT_MS=900000
# DZ23_RATE_LIMIT_ENABLED=true
# DZ23_RATE_LIMIT_WINDOW_MS=60000
# DZ23_RATE_LIMIT_POINTS=120
# DZ23_RATE_LIMIT_TOOL_POINTS=60
# DZ23_RATE_LIMIT_CONCURRENT=4
# DZ23_RATE_LIMIT_WEIGHTS=light:1,discovery:3,moderate:5,billable:10,expensive:15,very_expensive:30
